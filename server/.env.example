# Copy this file to .env and fill in the values. .env is git-ignored.
# Restart `npm run dev` after changing it.

# Gmail SMTP for sending login and registration codes.
# Gmail needs an App Password (2-Step Verification must be on). Your normal Gmail password is rejected.
# Create one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=zh7276869269@gmail.com
SMTP_PASS=
# Optional display sender; defaults to "UniSphere <SMTP_USER>"
SMTP_FROM=

# Leave SMTP_PASS empty to print codes to the server console instead (local demo).
JWT_SECRET=change-me-to-a-long-random-string
